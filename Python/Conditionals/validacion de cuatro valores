# This program checks whether four integers satisfy a set of given conditions.
a = int(input())
b = int(input())
c = int(input())
d = int(input())
def valor(a, b, c, d):
   if b > c and d > a and c + d > 0 and a%2 == 0 and c + d > a + b and c > 0 and d > 0:
     return "Valores aceptados"
   else:
     return "Valores no aceptados"
print(valor(a, b, c, d))
